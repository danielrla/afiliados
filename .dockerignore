*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/
.chrome_cache/
*.log
logs/
temp/
tmp/
.DS_Store
.git
.gitignore
.agents
.idea/
.vscode/
